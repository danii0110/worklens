{
  "name": "worklens",
  "version": "1.0.0",
  "description": "개인 업무정리 대시보드 (Jira 담당 티켓 현황)",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "prepare": "husky",
    "commit": "cz",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,html,css}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^9.39.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "commitizen": "^4.3.2",
    "cz-conventional-changelog": "^3.3.0",
    "electron": "^44.9.3",
    "electron-vite": "^6.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.307",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
